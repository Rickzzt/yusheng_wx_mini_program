<view class="page">
  <view class="card detail" wx:if="{{order}}">
    <text class="status-text">{{statusLabels[order.status]}}</text>
    <text class="room-name">{{order.roomName}}</text>
    <text class="muted">订单号：{{order.id}}</text>
    <view class="info-list">
      <view><text>入住日期</text><text>{{order.checkIn}} 至 {{order.checkOut}}</text></view>
      <view><text>入住晚数</text><text>{{order.nights}} 晚</text></view>
      <view><text>入住人数</text><text>{{order.guests}} 人</text></view>
      <view><text>联系人</text><text>{{order.contactName}}</text></view>
      <view><text>手机号</text><text>{{order.phone}}</text></view>
      <view><text>支付状态</text><text>{{order.paymentStatus}}</text></view>
      <view><text>订单金额</text><text class="price">¥{{order.amount}}</text></view>
    </view>
    <view class="notice">
      <text>入住须知</text>
      <text class="muted">{{order.cancelRule || "入住当天 18:00 前可免费取消"}}</text>
      <text class="muted">地址：{{hotel.address}}</text>
    </view>
    <view class="split-actions">
      <button class="ghost-btn" bindtap="copyAddress">复制地址</button>
      <button class="ghost-btn" bindtap="callHotel">联系民宿</button>
    </view>
  </view>

  <view class="card empty" wx:else>
    <text>未找到订单</text>
    <button class="primary-btn" bindtap="goOrders">返回订单列表</button>
  </view>
</view>
