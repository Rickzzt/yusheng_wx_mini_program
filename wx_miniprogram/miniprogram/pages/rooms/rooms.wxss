.filter-scroll {
  margin: 4rpx -28rpx 24rpx;
  width: calc(100% + 56rpx);
}

.filter-row {
  display: flex;
  gap: 14rpx;
  padding: 0 28rpx 4rpx;
  white-space: nowrap;
}

.filter {
  background: #fffdf8;
  border: 1rpx solid rgba(65, 82, 75, 0.13);
  border-radius: 999rpx;
  color: #60726a;
  font-size: 26rpx;
  padding: 16rpx 28rpx;
}

.filter.active {
  background: #1f5f58;
  color: #fffdf8;
}

.room-card {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
}

.room-cover {
  height: 360rpx;
  overflow: hidden;
}

.room-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx;
}

.room-head,
.room-bottom,
.facts {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.room-name {
  color: #24332f;
  font-size: 34rpx;
  font-weight: 800;
  max-width: 480rpx;
}

.status {
  background: #e8f4ef;
  border-radius: 999rpx;
  color: #1f5f58;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 14rpx;
}

.facts {
  color: #5d6d66;
  font-size: 24rpx;
  gap: 14rpx;
  justify-content: flex-start;
}

.detail-link {
  color: #1f5f58;
  font-size: 26rpx;
  font-weight: 700;
}
