<view class="page">
  <view class="hero-image">
    <image src="{{hero}}" mode="aspectFill" />
  </view>

  <view class="card about-card">
    <text class="kicker">{{hotel.city}}</text>
    <text class="title">{{hotel.name}}</text>
    <text class="muted">{{hotel.address}}</text>
    <view class="tag-row">
      <text class="tag" wx:for="{{hotel.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title"><text>民宿设施</text></view>
    <view class="tag-row">
      <text class="tag" wx:for="{{hotel.facilities}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title"><text>周边与交通</text></view>
    <view class="list">
      <view><text>周边</text><text>{{nearbyText}}</text></view>
      <view><text>交通</text><text>{{trafficText}}</text></view>
      <view><text>携程酒店 ID</text><text>{{hotel.ctripId}}</text></view>
    </view>
  </view>

  <view class="split-actions">
    <button class="ghost-btn" bindtap="copyAddress">复制地址</button>
    <button class="ghost-btn" bindtap="openCtrip">复制携程链接</button>
  </view>
  <button class="primary-btn contact" bindtap="callHotel">联系民宿</button>
  <button class="admin-link" bindtap="goAdmin">经营者入口</button>
</view>
