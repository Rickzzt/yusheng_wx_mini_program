/**app.wxss**/
page {
  background: #f5f3ee;
  color: #24332f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  background: transparent;
  padding: 0;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.hero-image {
  width: 100%;
  height: 420rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: #d9ded3;
}

.hero-image image,
.room-cover image,
.photo-strip image {
  width: 100%;
  height: 100%;
  display: block;
}

.card {
  background: #fffdf8;
  border: 1rpx solid rgba(65, 82, 75, 0.12);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 60rpx rgba(58, 72, 61, 0.08);
  box-sizing: border-box;
  padding: 28rpx;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title text:first-child {
  color: #24332f;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #728078;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: #eaf0ea;
  border-radius: 999rpx;
  color: #3f685e;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.primary-btn,
.ghost-btn,
.danger-btn {
  align-items: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  height: 88rpx;
  justify-content: center;
}

.primary-btn {
  background: #1f5f58;
  color: #fffdf8;
}

.ghost-btn {
  background: #edf3f1;
  color: #1f5f58;
}

.danger-btn {
  background: #f8e9e2;
  color: #9d4a31;
}

.price {
  color: #9d5a24;
  font-size: 34rpx;
  font-weight: 800;
}

.price small {
  color: #728078;
  font-size: 22rpx;
  font-weight: 500;
}

.price-stack {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.price-line {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.deal-label {
  color: #b35a2a;
  font-size: 22rpx;
  font-weight: 700;
}

.original-price {
  color: #9aa39e;
  font-size: 24rpx;
  text-decoration: line-through;
}

.field {
  margin-top: 24rpx;
}

.field label {
  color: #44544f;
  display: block;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.field input,
.field textarea,
.field picker {
  background: #fffdf8;
  border: 1rpx solid rgba(65, 82, 75, 0.14);
  border-radius: 20rpx;
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 20rpx;
  width: 100%;
}

.split-actions {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 26rpx;
}
